<!-- OVSRollbackNode.csproj: the P2P node, the process on a player's machine that the game connects to as its
     rollback server. Hosts the engine (OVSRollbackServer) when this player is the match's host; forwards to the
     host's node otherwise. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>OVS.Rollback.Node</RootNamespace>
    <AssemblyName>OVS.Rollback.Node</AssemblyName>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <PublishReadyToRun>true</PublishReadyToRun>
    <!-- No ICU: the node formats nothing for a person, and a self-contained build without this needs libicu on the
         player's machine, which Steam's Linux runtime container is not known to provide. -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <!-- The lockdown's build inputs (NodeBuild.cs reads them back). A locked node trusts one server, NodeServer, and only
       configs signed with the private half of NodeConfigPublicKey (base64 SubjectPublicKeyInfo, ECDSA P-256); it has no
       default, so a release build without it fails rather than trusting nothing or the wrong key. build.sh passes it from
       pki/<env>/node-config-public-key.txt. NodeUnlocked=true (the bench, and every Debug build) honors the player's own values
       for every setting and the server from the command line; without a key it does not check signatures at all. -->
  <PropertyGroup>
    <NodeServer Condition="'$(NodeServer)' == ''">https://prod.openversus.org</NodeServer>
    <NodeUnlocked Condition="'$(NodeUnlocked)' == '' and '$(Configuration)' == 'Debug'">true</NodeUnlocked>
    <NodeUnlocked Condition="'$(NodeUnlocked)' == ''">false</NodeUnlocked>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="NodeServer" Value="$(NodeServer)" />
    <AssemblyMetadata Include="NodeConfigPublicKey" Value="$(NodeConfigPublicKey)" />
    <AssemblyMetadata Include="NodeUnlocked" Value="$(NodeUnlocked)" />
  </ItemGroup>
  <Target Name="RequireNodeConfigPublicKey" BeforeTargets="BeforeBuild" Condition="'$(NodeUnlocked)' != 'true' and '$(NodeConfigPublicKey)' == ''">
    <Error Text="A locked node needs the server's public key: -p:NodeConfigPublicKey=&lt;base64 SubjectPublicKeyInfo&gt; (build.sh reads pki/prod/node-config-public-key.txt), or -p:NodeUnlocked=true for a bench build." />
  </Target>
  <ItemGroup>
    <ProjectReference Include="../OVSRollbackServer/OVSRollbackServer.csproj" />
    <ProjectReference Include="../OVSRollbackP2P/OVSRollbackP2P.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The engine's appsettings.json comes along with its assembly and is read first; NodeHost then loads
         node.appsettings.json over it (the two cannot share a name in the publish output). The Serilog config has
         to sit next to the engine's assembly at this relative path. -->
    <None Update="node.appsettings.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <!-- The same file inside the binary: the built-in values a locked node falls back to (NodeLockdown). -->
    <EmbeddedResource Include="node.appsettings.json" LogicalName="node.appsettings.json" />
    <None Include="../OVSRollbackServer/Configuration/Logging/Runtime/serilog-config.json" Link="Configuration/Logging/Runtime/serilog-config.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
