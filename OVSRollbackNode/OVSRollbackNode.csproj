<!-- OVSRollbackNode.csproj: the P2P node, the process on a player's machine that the game connects to as its
     rollback server. Hosts the engine (OVSRollbackServer) when this player is the match's host; forwards to the
     host's node otherwise. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>OVS.Rollback.Node</RootNamespace>
    <AssemblyName>OVS.Rollback.Node</AssemblyName>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <PublishReadyToRun>true</PublishReadyToRun>
    <!-- No ICU: the node formats nothing for a person, and a self-contained build without this needs libicu on the
         player's machine, which Steam's Linux runtime container is not known to provide. -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <!-- The lockdown's build inputs (NodeBuild.cs reads them back). NodeTrust lists the servers a locked node may talk to,
       each with the public key its configs are signed with: "url key url key ..." (whitespace-separated; keys are base64
       SubjectPublicKeyInfo, ECDSA P-256). The first is the default; the server option the mod passes (the game's
       ServerUrl) picks among them, and a server not on the list gets the default. It has no default, so a release build
       without it fails rather than trusting nothing or the wrong key; build.sh writes it from pki/<env>/ (server-url.txt,
       node-config-public-key.txt).
       NodeUnlocked=true (the bench, and every Debug build) honors the player's own values for every setting and the
       server from the command line; without a key it does not check signatures at all. -->
  <PropertyGroup>
    <NodeUnlocked Condition="'$(NodeUnlocked)' == '' and '$(Configuration)' == 'Debug'">true</NodeUnlocked>
    <NodeUnlocked Condition="'$(NodeUnlocked)' == ''">false</NodeUnlocked>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="NodeTrust" Value="$(NodeTrust)" />
    <AssemblyMetadata Include="NodeUnlocked" Value="$(NodeUnlocked)" />
  </ItemGroup>
  <Target Name="RequireNodeTrust" BeforeTargets="BeforeBuild" Condition="'$(NodeUnlocked)' != 'true' and '$(NodeTrust)' == ''">
    <Error Text="A locked node needs the servers it trusts: -p:NodeTrust=&quot;&lt;url&gt; &lt;public key&gt; ...&quot; (build.sh writes it from pki/&lt;env&gt;/), or -p:NodeUnlocked=true for a bench build." />
  </Target>
  <ItemGroup>
    <ProjectReference Include="../OVSRollbackServer/OVSRollbackServer.csproj" />
    <ProjectReference Include="../OVSRollbackP2P/OVSRollbackP2P.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The engine's appsettings.json comes along with its assembly and is read first; NodeHost then loads
         node.appsettings.json over it (the two cannot share a name in the publish output). The Serilog config has
         to sit next to the engine's assembly at this relative path. -->
    <None Update="node.appsettings.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <!-- The same file inside the binary: the built-in values a locked node falls back to (NodeLockdown). -->
    <EmbeddedResource Include="node.appsettings.json" LogicalName="node.appsettings.json" />
    <None Include="../OVSRollbackServer/Configuration/Logging/Runtime/serilog-config.json" Link="Configuration/Logging/Runtime/serilog-config.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
