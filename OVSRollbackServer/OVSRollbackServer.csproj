<!-- RollbackServer.csproj -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Rollback</RootNamespace>
    <!-- Server GC: dedicated GC threads, shorter pauses under allocation pressure -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <!-- Concurrent GC: collections happen alongside application threads -->
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <!-- Tiered PGO: JIT uses runtime profile data for better codegen on hot paths -->
    <TieredPGO>true</TieredPGO>
    <!-- Required for SkipLocalsInit attribute (optional, used on hot serializer) -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup Label="PackageReferences">
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.3" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.3" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.3" />
    <!-- OpenTelemetry for metrics export -->
    <PackageReference Include="OpenTelemetry" Version="1.15.0" />
    <PackageReference Include="OpenTelemetry.Exporter.Console" Version="1.15.0" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.15.0" />
  </ItemGroup>

</Project>

