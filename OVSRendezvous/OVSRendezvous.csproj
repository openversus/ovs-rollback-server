<!-- OVSRendezvous.csproj: the P2P rendezvous service, its own executable. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>OVS.Rollback.Rendezvous</RootNamespace>
    <AssemblyName>OVS.Rollback.Rendezvous</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.7" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../OVSRollbackP2P/OVSRollbackP2P.csproj" />
  </ItemGroup>
</Project>
