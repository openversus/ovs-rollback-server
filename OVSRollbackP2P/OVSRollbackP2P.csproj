<!-- OVSRollbackP2P.csproj: the P2P wire protocol, hole punching and the rendezvous registry. No dependency on the
     engine, so the rendezvous service and the tests build without it. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>OVS.Rollback.P2P</RootNamespace>
    <AssemblyName>OVS.Rollback.P2P</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.7" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="OVS.Rollback.P2P.Tests" />
  </ItemGroup>
</Project>
